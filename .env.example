# Gemini API Key (for LLM code security audit)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Webhook & API Credentials
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key_here

# Queue & Database Connection URLs
REDIS_URL=redis://localhost:6379
DATABASE_URL="file:./dev.db"

# Application Config
PORT=3000
NODE_ENV=development
